        "path": "a696c285-ef54-48fa-9fd6-523b1d85e54d",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "sanitize",
      "name": "Validar y minimizar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "\nconst b=$json.body;\nconst ignore=()=>[{json:{action:'ignore'}}];\nif(!b||b.instance!=='psicologos-en-colombia'||b.event!=='messages.upsert')return ignore();\nconst owner=String(b.sender||'').split('@')[0].split(':')[0];\nif(owner!=='573016818845')return ignore();\nconst d=b.data, k=d?.key;\nif(!k||typeof k.id!=='string'||typeof k.fromMe!=='boolean')return ignore();\nif(String(k.remoteJid).endsWith('@g.us')||k.remoteJid==='status@broadcast')return ignore();\nconst jid=[k.remoteJid,k.remoteJidAlt].find(x=>typeof x==='string'&&/^[1-9]\\d{7,14}@s\\.whatsapp\\.net$/.test(x));\nif(!jid)return ignore();\nconst phone=jid.split('@')[0];\nconst m=d.message||{};\nif(m.protocolMessage||m.reactionMessage||m.senderKeyDistributionMessage)return ignore();\nconst text=m.conversation??m.extendedTextMessage?.text??m.imageMessage?.caption??m.documentMessage?.caption??'';\nif(typeof text!=='string')return ignore();\nlet seconds=Number(d.messageTimestamp?.low??d.messageTimestamp);\nif(!Number.isFinite(seconds)||seconds<0||seconds>100000000000)return ignore();\nconst kind=m.audioMessage?'audio':(m.conversation!==undefined||m.extendedTextMessage?'text':'attachment');\n// Preserve only the quoted plain text as untrusted context, never credentials or media.\nconst q=(m.extendedTextMessage||m.imageMessage||m.documentMessage||m.audioMessage)?.contextInfo?.quotedMessage;\nconst quoted=q?.conversation??q?.extendedTextMessage?.text??q?.imageMessage?.caption??q?.documentMessage?.caption;\nconst quotedText=typeof quoted==='string'?quoted.slice(0,1800):'';\nreturn [{json:{action:'event',instance:b.instance,owner,event:{id:k.id,phone,fromMe:k.fromMe,at:new Date(seconds*1000).toISOString(),kind,text:text.slice(0,8000),...(quotedText?{quotedText}:{})}}}];\n"
      }
    },
    {
      "id": "Guardar en Axis",
      "name": "Guardar en Axis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
